<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.atengk</groupId>
        <artifactId>ateng-boot</artifactId>
        <version>1.2.0</version>
    </parent>

    <artifactId>ateng-boot-rocketmq</artifactId>
    <packaging>jar</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>ateng-boot RocketMQ 5.x 生产增强与原生分布式事务底座（基于 RocketMQ 5.x 官方 gRPC 瘦客户端，提供受管高阶门面 RocketmqTemplate、延时与 FIFO 保序消息、原生 2PC 分布式事务半消息与统一回查分发架构 RocketmqTransactionChecker、事务感知发信 sendAfterCommit、声明式 @RocketmqListener 事件驱动容器、微服务推断反序列化解耦、大报文 4MB 前置防御与 4KB 透明 GZIP 压缩、消费端毒丸丢弃与 @Idempotent 幂等静默确认、SmartLifecycle 确定性停机排空与 100% 离线自洽 TestDouble 测试沙箱）</description>

    <dependencies>
        <!-- 核心底座依赖 (提供消息头常量、四维上下文传播、毒丸判定器与异常契约) -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-core</artifactId>
        </dependency>

        <!-- RocketMQ 5.x 官方新一代 gRPC 瘦客户端 (Shaded 版本，彻底消除 gRPC 与 Netty 依赖冲突) -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-client-java</artifactId>
        </dependency>

        <!-- Spring 事务支持 (用于 sendAfterCommit 本地事务生命周期感知) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>

        <!-- Spring Boot 自动装配支持 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- 编译期配置注解处理器 (自动生成 IDE 智能配置补全元数据) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Lombok (编译期使用) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 单元测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
