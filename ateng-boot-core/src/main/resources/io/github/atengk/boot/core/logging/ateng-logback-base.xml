<?xml version="1.0" encoding="UTF-8"?>
<included>

    <!-- 动态从 Spring Environment 读取配置属性 -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="application"/>
    <springProperty scope="context" name="LOG_PATH" source="ateng.boot.core.logging.file.path" defaultValue="logs"/>
    <springProperty scope="context" name="MAX_FILE_SIZE" source="ateng.boot.core.logging.file.max-file-size" defaultValue="100MB"/>
    <springProperty scope="context" name="MAX_HISTORY" source="ateng.boot.core.logging.file.max-history" defaultValue="30"/>
    <springProperty scope="context" name="TOTAL_SIZE_CAP" source="ateng.boot.core.logging.file.total-size-cap" defaultValue="10GB"/>
    <springProperty scope="context" name="LOG_LEVEL" source="logging.level.root" defaultValue="INFO"/>

    <!-- 彩色控制台格式（含 MDC traceId） -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) %magenta([%15.15thread]) %green([%replace(%X{traceId}){'^$', 'NO-TRACE'}]) %cyan(%-40.40logger{39}) : %msg%n"/>

    <!-- 文件纯文本格式（含 MDC traceId） -->
    <property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%15.15thread] [%replace(%X{traceId}){'^$', 'NO-TRACE'}] %-40.40logger{39} : %msg%n"/>

    <!-- 控制台 Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

</included>
