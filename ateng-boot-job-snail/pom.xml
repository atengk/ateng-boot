<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.atengk</groupId>
        <artifactId>ateng-boot</artifactId>
        <version>1.2.0</version>
    </parent>

    <artifactId>ateng-boot-job-snail</artifactId>
    <packaging>jar</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>ateng-boot 工业级 SnailJob 分布式任务调度与分布式重试双擎生产加固底座（基于 2.0.2 基线，支持自动装配、四维上下文透传与远程重试保真、SLF4J 动态日志镜像、本地硬看门狗、强类型入参校验与 100% 离线自洽沙箱）</description>

    <dependencies>
        <!-- 核心底座依赖 (提供统一异常契约、结果码、四维上下文透传与受管线程池设施) -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-core</artifactId>
        </dependency>

        <!-- SnailJob 官方客户端核心 Starter 与双擎依赖 (2.0.2 基线，BOM 统管) -->
        <dependency>
            <groupId>com.aizuda</groupId>
            <artifactId>snail-job-client-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aizuda</groupId>
            <artifactId>snail-job-client-job-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aizuda</groupId>
            <artifactId>snail-job-client-retry-core</artifactId>
        </dependency>

        <!-- Spring Boot 核心基础设施 (提供 @AutoConfiguration、事件总线与生命周期) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Spring Boot AOP (用于 @JobExecutor、@Retryable 上下文切面拦截) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- 参数校验 Starter (用于调度入参与重试 JSR-303 防卫与 ValidatorUtil 支持) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Boot 配置处理器 (可选，编译期生成 IDE 配置元数据) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 日志门面 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- 可选依赖：Spring Boot Actuator (用于运维管控与健康探针) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 可选依赖：Micrometer 核心指标采集 (用于调度任务吞吐、耗时百分位与监控度量) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 可选依赖：协同通知组件 (用于死信与告警风暴抑制桥接) -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-notification</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 可选依赖：MyBatis-Plus 流式游标支持 (用于 SnailShardingBatchTemplate 大数据流式游标对接) -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-mybatis-plus</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Lombok (编译期使用，不传递) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 测试依赖套件 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
