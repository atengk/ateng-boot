<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="60 seconds">

    <!-- 彩色控制台日志输出格式（包含 MDC traceId 标记与高亮） -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) %magenta([%15.15thread]) %green([%replace(%X{traceId}){'^$', 'NO-TRACE'}]) %cyan(%-40.40logger{39}) : %msg%n"/>

    <!-- 控制台 Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 框架业务包日志级别配置 -->
    <logger name="io.github.atengk.boot" level="DEBUG"/>
    <logger name="org.springframework.web" level="INFO"/>

    <!-- 环境分流配置 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
