<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.atengk</groupId>
        <artifactId>ateng-boot-samples</artifactId>
        <version>1.2.0</version>
    </parent>

    <artifactId>ateng-boot-sample-storage</artifactId>
    <packaging>jar</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>ateng-boot 通用对象存储自验集成样例（多源动态路由、断点续传与预签名外链）</description>

    <dependencies>
        <!-- Web 运行时增强 Starter -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-web</artifactId>
        </dependency>

        <!-- 对象存储核心 Starter -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-storage</artifactId>
        </dependency>

        <!-- AWS SDK S3 客户端（开启云原生 S3 驱动与企业级治理能力） -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>

        <!-- AWS SDK Apache HTTP Client 连接池传输实现 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>apache-client</artifactId>
        </dependency>

        <!-- Spring Boot Actuator 健康检查与监控 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- SpringDoc OpenAPI (用于接口文档与外链调试) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
