<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.atengk</groupId>
        <artifactId>ateng-boot-samples</artifactId>
        <version>1.2.0</version>
    </parent>

    <artifactId>ateng-boot-sample-observability</artifactId>
    <packaging>jar</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>ateng-boot 云原生可观测性场景样例（Actuator 安全加固 / Prometheus 度量抓取 / 线程池动态打标 / 超时熔断探针 / K8s 黄金探针）</description>

    <dependencies>
        <!-- 云原生可观测性 Starter -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-observability</artifactId>
        </dependency>

        <!-- Web 运行时增强 Starter -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-web</artifactId>
        </dependency>

        <!-- MyBatis-Plus 持久层底座（提供数据源与 DynamicDatasourceGuard 联动健康探测） -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-mybatis-plus</artifactId>
        </dependency>

        <!-- Storage 存储底座（提供对象存储健康探针联动自验） -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-storage</artifactId>
        </dependency>

        <!-- H2 内存数据库 (运行时自验，零外部真实数据库依赖) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
