<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.atengk</groupId>
        <artifactId>ateng-boot-samples</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>ateng-boot-sample-ftp</artifactId>
    <packaging>jar</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>ateng-boot FTP 客户端自验集成样例（连接池复用、多节点动态切源、原子上传与文件系统操作）</description>

    <dependencies>
        <!-- Web 运行时增强 Starter (显式 Result<T> 响应、统一异常拦截等) -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-web</artifactId>
        </dependency>

        <!-- FTP 核心 Starter -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-ftp</artifactId>
        </dependency>

        <!-- Spring Boot Actuator 健康检查与监控 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- MockFtpServer (用于离线端到端测试) -->
        <dependency>
            <groupId>org.mockftpserver</groupId>
            <artifactId>MockFtpServer</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
