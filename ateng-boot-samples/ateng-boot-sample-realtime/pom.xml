<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.atengk</groupId>
        <artifactId>ateng-boot-samples</artifactId>
        <version>1.2.0</version>
    </parent>

    <artifactId>ateng-boot-sample-realtime</artifactId>
    <packaging>jar</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>ateng-boot 工业级实时通信底座自验集成样例（双模全双工/流式通道、声明式上行路由、单机会话协同与离线自洽实测）</description>

    <dependencies>
        <!-- Web 运行时增强 Starter -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-web</artifactId>
        </dependency>

        <!-- 实时通信双模引擎核心 Starter -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-realtime</artifactId>
        </dependency>

        <!-- Sa-Token 权限与会话安全 Starter (用于三阶握手鉴权实测) -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
