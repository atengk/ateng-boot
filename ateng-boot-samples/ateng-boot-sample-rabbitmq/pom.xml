<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.atengk</groupId>
        <artifactId>ateng-boot-samples</artifactId>
        <version>1.2.0</version>
    </parent>

    <artifactId>ateng-boot-sample-rabbitmq</artifactId>
    <packaging>jar</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>ateng-boot RabbitMQ 生产级路由与可靠投递自验集成样例（Direct/Topic拓扑、@Idempotent静默ACK、延时队列、DLQ死信诊断与sendAfterCommit事务发信）</description>

    <dependencies>
        <!-- RabbitMQ 生产级增强 Starter -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-rabbitmq</artifactId>
        </dependency>

        <!-- Spring AMQP 官方测试支持 (提供 TestRabbitTemplate 等离线模拟工具) -->
        <dependency>
            <groupId>org.springframework.amqp</groupId>
            <artifactId>spring-rabbit-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
