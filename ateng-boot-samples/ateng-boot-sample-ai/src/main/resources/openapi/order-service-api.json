{
  "openapi": "3.0.1",
  "info": {
    "title": "企业订单服务 OpenAPI 契约",
    "description": "提供订单创建、查询、更新与作废等标准化 RESTful 业务能力",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "本地开发与样例测试环境服务基地址"
    }
  ],
  "paths": {
    "/api/v1/orders": {
      "get": {
        "operationId": "listOrders",
        "summary": "分页查询订单列表",
        "description": "支持按订单状态和页码筛选系统订单",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "页码，从 1 开始",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "订单状态（PENDING, PAID, SHIPPED, CANCELLED）",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "operationId": "createOrder",
        "summary": "创建商品订单",
        "description": "提交买家信息与订单金额创建新订单",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{id}": {
      "get": {
        "operationId": "getOrderById",
        "summary": "根据订单ID查询订单详情",
        "description": "返回指定订单编号的明细信息与物流状态",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "订单唯一主键ID",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "includeItems",
            "in": "query",
            "required": false,
            "description": "是否返回订单行商品条目",
            "schema": {
              "type": "boolean"
            }
          }
        ]
      },
      "delete": {
        "operationId": "cancelOrder",
        "summary": "取消或作废订单",
        "description": "作废指定ID的未完成订单",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "待作废订单主键ID",
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateOrderRequest": {
        "type": "object",
        "required": ["buyerName", "amount"],
        "properties": {
          "buyerName": {
            "type": "string",
            "description": "买家联系姓名"
          },
          "amount": {
            "type": "number",
            "description": "订单总计支付金额"
          },
          "channel": {
            "type": "string",
            "description": "下单业务渠道（ONLINE, OFFLINE, APP）",
            "enum": ["ONLINE", "OFFLINE", "APP"]
          },
          "remark": {
            "type": "string",
            "description": "用户下单备注说明"
          }
        }
      }
    }
  }
}
