<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.atengk</groupId>
        <artifactId>ateng-boot-samples</artifactId>
        <version>1.2.0</version>
    </parent>

    <artifactId>ateng-boot-sample-ai</artifactId>
    <packaging>jar</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>ateng-boot 工业级智能体与认知图底座集成自验样例（OpenAI 网关、流式打字机、MockWebServer 离线自洽测试）</description>

    <dependencies>
        <!-- Web 运行时增强 Starter -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-web</artifactId>
        </dependency>

        <!-- AI 核心 Starter -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-ai</artifactId>
        </dependency>

        <!-- Milvus 向量数据库 Starter -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-milvus</artifactId>
        </dependency>

        <!-- Redis 向量数据库驱动 (LangChain4j) -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-redis</artifactId>
        </dependency>

        <!-- PostgreSQL PgVector 向量数据库驱动 (LangChain4j) -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-pgvector</artifactId>
        </dependency>

        <!-- 对象存储 Starter (用于 RAG 多模态文档内嵌图表持久化与 URL 链接生成) -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-storage</artifactId>
        </dependency>

        <!-- 企业级 Word 与 PDF 文档综合治理 (用于 RAG 多模态文档解析与图表提取) -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-document</artifactId>
        </dependency>

        <!-- Micrometer 核心度量 (用于 AI 黄金指标监控与探查) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <!-- OkHttp MockWebServer (纯内存离线测试，版本由 Spring Boot 统管) -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
