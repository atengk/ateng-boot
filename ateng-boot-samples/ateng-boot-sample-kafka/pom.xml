<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.atengk</groupId>
        <artifactId>ateng-boot-samples</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>ateng-boot-sample-kafka</artifactId>
    <packaging>jar</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>ateng-boot Kafka 生产级高吞吐流批处理与可靠投递自验集成样例（Key分区保序、sendAfterCommit事务感知发信、微服务推断反序列化、@Idempotent静默提交、毒丸0次重试进DLT、双容器工厂、KafkaRecordExecutor批量多租户隔离与100%离线自洽测试）</description>

    <dependencies>
        <!-- Web 依赖 (提供场景 Controller 接口与 HTTP 体验) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Kafka 生产级增强 Starter -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-kafka</artifactId>
        </dependency>

        <!-- Spring Kafka 官方测试支持 (提供 @EmbeddedKafka 等离线模拟工具) -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
