<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.atengk</groupId>
        <artifactId>ateng-boot</artifactId>
        <version>1.2.0</version>
    </parent>

    <artifactId>ateng-boot-social</artifactId>
    <packaging>jar</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>ateng-boot 企业级第三方社会化登录与 OAuth2 底座（支持微信扫码/公众号/小程序、QQ、GitHub、Gitee、钉钉、飞书等统一授权认证、Spring 6 RestClient 驱动、两阶段绑定、阅后即焚防重放、Sa-Token 深度会话打通与防孤儿死号治理）</description>

    <dependencies>
        <!-- 核心底座依赖 -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-core</artifactId>
        </dependency>

        <!-- Dromara Anduin 第三方 OAuth2 授权核心协议引擎 -->
        <dependency>
            <groupId>org.dromara.anduin</groupId>
            <artifactId>dromara-anduin</artifactId>
        </dependency>
        <!-- Dromara Anduin 运行时所需基础支持组件 (原库声明为 provided，在此提供生产就绪运行时依赖) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Spring Boot 自动装配支持 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- Spring Web (包含 RestClient 与 HTTP 契约) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- Sa-Token 安全鉴权底座 (可选集成，用于登录会话签发与多端多设备治理) -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-satoken</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Redis 基础设施 (可选集成，用于分布式 OAuth2 State 防伪与 bindTicket 缓存) -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring MVC (可选集成，用于 SocialAuthController 暴露) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Apache HttpClient 5 (可选池化客户端，存在时自适应复用) -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 编译期配置注解处理器 (自动生成 IDE 智能配置补全元数据) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Lombok (编译期使用) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 单元测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- OkHttp MockWebServer (纯内存离线自洽测试，版本由 Spring Boot 统管) -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
